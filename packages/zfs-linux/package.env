# Debian source package to rebuild.
SOURCE=zfs-linux
# Debian codenames to build for.
CODENAMES="trixie"
# The upstream version the patches apply to. A Debian release with another
# upstream version fails the build until the patches are rebased.
UPSTREAM_VERSION=2.3.9
# Published version: <Debian version>+<SUFFIX><REVISION>. Bump REVISION when
# the patches change.
SUFFIX=sse
REVISION=1
CHANGELOG="Add SSE4.1 AES-GCM acceleration from https://github.com/mafredri/zfs/pull/1."
# update-patches.sh exports PATCH_BASE..PATCH_HEAD from PATCH_REPO.
PATCH_REPO=https://github.com/mafredri/zfs.git
PATCH_BASE=zfs-2.3-release
PATCH_HEAD=zfs-2.3-sse-gcm
# Paths update-patches.sh leaves out because Debian's source does not ship them.
PATCH_EXCLUDE="scripts/spdxcheck.pl"
