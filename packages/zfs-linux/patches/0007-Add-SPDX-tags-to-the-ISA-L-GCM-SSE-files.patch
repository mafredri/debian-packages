 contrib/icp/gcm-simd/isa-l_crypto-ported/gcm256_sse.S  | 1 +
 contrib/icp/gcm-simd/isa-l_crypto-ported/gcm_defines.S | 1 +
 contrib/icp/gcm-simd/isa-l_crypto-ported/gcm_sse.S     | 1 +
 contrib/icp/gcm-simd/isa-l_crypto-ported/reg_sizes.S   | 1 +
 module/icp/asm-x86_64/modes/isalc_gcm128_sse.S         | 1 +
 module/icp/asm-x86_64/modes/isalc_gcm192_sse.S         | 1 +
 module/icp/asm-x86_64/modes/isalc_gcm256_sse.S         | 1 +
 module/icp/asm-x86_64/modes/isalc_gcm_defines.S        | 1 +
 module/icp/asm-x86_64/modes/isalc_gcm_sse.S            | 1 +
 module/icp/asm-x86_64/modes/isalc_reg_sizes.S          | 1 +
 11 files changed, 11 insertions(+)

diff --git a/contrib/icp/gcm-simd/isa-l_crypto-ported/gcm128_sse.S b/contrib/icp/gcm-simd/isa-l_crypto-ported/gcm128_sse.S
index 6b6422291dc2..9edb6543c14c 100644
--- a/contrib/icp/gcm-simd/isa-l_crypto-ported/gcm128_sse.S
