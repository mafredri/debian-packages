+		aesenc	\T1, \XMM2
+		aesenc	\T1, \XMM3
+		aesenc	\T1, \XMM4
+		aesenc	\T1, \XMM5
+		aesenc	\T1, \XMM6
+		aesenc	\T1, \XMM7
+		aesenc	\T1, \XMM8
+
+		movdqu	16*12(\GDATA), \T1
+		aesenc	\T1, \XMM1
+		aesenc	\T1, \XMM2
+		aesenc	\T1, \XMM3
+		aesenc	\T1, \XMM4
+		aesenc	\T1, \XMM5
+		aesenc	\T1, \XMM6
+		aesenc	\T1, \XMM7
+		aesenc	\T1, \XMM8
+
+		movdqu	16*13(\GDATA), \T1
+		aesenc	\T1, \XMM1
+		aesenc	\T1, \XMM2
+		aesenc	\T1, \XMM3
+		aesenc	\T1, \XMM4
+		aesenc	\T1, \XMM5
+		aesenc	\T1, \XMM6
+		aesenc	\T1, \XMM7
