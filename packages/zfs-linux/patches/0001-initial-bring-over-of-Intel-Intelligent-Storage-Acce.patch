+	psrldq	$8, \T2			// shift-R \T2 2 DWs
+	pxor	\T3, \T7
+	pxor	\T2, \T4		// accumulate the results in \T4:\T7
+
+
+
+	//first phase of the reduction
+	movdqa	\T7, \T2
+	movdqa	\T7, \T3
+	movdqa	\T7, \T1		// move \T7 into \T2, \T3, \T1 in order to perform the three shifts independently
