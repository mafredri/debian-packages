+	pclmulqdq	$0x00, \T5, \T3		// \T3 = a0*b0
+	movdqu  HashKey_3_k(\GDATA), \T5
+	pclmulqdq	$0x00, \T5, \T2		// \T2 = (a1+a0)*(b1+b0)
+	pxor	\T1, \T4			// accumulate the results in \T4:\T7, \T6 holds the middle part
+	pxor	\T3, \T7
+	pxor	\T2, \T6
+
+		movdqu	16*7(\GDATA), \T1
+		aesenc	\T1, \XMM1
+		aesenc	\T1, \XMM2
+		aesenc	\T1, \XMM3
+		aesenc	\T1, \XMM4
+		aesenc	\T1, \XMM5
+		aesenc	\T1, \XMM6
+		aesenc	\T1, \XMM7
+		aesenc	\T1, \XMM8
+
