+////////////////////////////////////////////////////////////////////////////////
+#if FUNCT_EXTENSION != _nt
+.global FN_NAME(enc,_finalize_)
+FN_NAME(enc,_finalize_):
+
+	endbranch
+
+	push	%r12
+
+#if __OUTPUT_FORMAT__ == win64
