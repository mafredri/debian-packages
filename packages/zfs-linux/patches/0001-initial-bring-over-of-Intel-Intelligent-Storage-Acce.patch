+////////////////////////////////////////////////////////////////////////////////
+//void   aes_gcm_dec_128_sse / aes_gcm_dec_256_sse
+//        const struct gcm_key_data *key_data,
+//        struct gcm_context_data *context_data,
+//        u8      *out,
+//        const   u8 *in,
+//        u64     plaintext_len,
